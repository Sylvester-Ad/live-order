# Base path used by browser requests. Keep /api for the same-origin proxy setup.
# This is public and is safe to expose to the browser.
VITE_API_BASE_URL=/api

# Upstream API origin for Vite's local development proxy.
# This is a local-only development setting and is not exposed to browser code.
# Set this when the backend runs somewhere other than http://localhost:3000.
API_PROXY_TARGET=http://localhost:3000
