# CDK target account and region. Leave blank to use AWS CLI profile defaults.
CDK_DEFAULT_ACCOUNT=
CDK_DEFAULT_REGION=

# Required: recipient for AWS Budget notifications. Verify the email after deployment.
LIVEORDER_BUDGET_EMAIL=

# Optional infrastructure settings; defaults are shown.
LIVEORDER_GITHUB_REPOSITORY=Sylvester-Ad/live-order
LIVEORDER_GITHUB_ENVIRONMENT=production
LIVEORDER_INSTANCE_TYPE=t4g.small
LIVEORDER_DATA_VOLUME_GIB=30
LIVEORDER_COMPOSE_VERSION=2.39.4
LIVEORDER_RUNTIME_SECRET_NAME=liveorder/production/runtime
