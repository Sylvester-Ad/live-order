http://www.liveorder.site {
	redir https://liveorder.site{uri} permanent
}

https://www.liveorder.site {
	redir https://liveorder.site{uri} permanent
}

{$SITE_ADDRESS::80} {
	encode zstd gzip

	@backend path /api /api/* /api-docs /api-docs/* /api-docs.json
	handle @backend {
		reverse_proxy backend:3000
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
