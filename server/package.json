{
  "name": "server",
  "version": "1.0.0",
  "private": true,
  "description": "",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server/src/server.js",
    "build": "pnpm run clean && pnpm --dir .. db:generate && pnpm --dir .. exec tsc -p server/tsconfig.build.json",
    "clean": "node scripts/clean-dist.mjs",
    "typecheck": "pnpm --dir .. exec tsc --noEmit -p tsconfig.json",
    "creator:create": "tsx src/scripts/create-creator.ts",
    "creator:create:production": "node dist/server/src/scripts/create-creator.js",
    "migrate:deploy:production": "node dist/server/src/scripts/migrate-deploy.js",
    "backup:create": "tsx src/scripts/backup-sqlite.ts",
    "backup:upload": "tsx src/scripts/upload-sqlite-backup.ts",
    "backup:restore": "tsx src/scripts/restore-sqlite-backup.ts",
    "backup:create:production": "node dist/server/src/scripts/backup-sqlite.js",
    "backup:upload:production": "node dist/server/src/scripts/upload-sqlite-backup.js",
    "backup:restore:production": "node dist/server/src/scripts/restore-sqlite-backup.js",
    "test:prepare": "tsx src/scripts/prepare-test-db.ts",
    "test": "pnpm run test:prepare && vitest run",
    "test:watch": "pnpm run test:prepare && vitest"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.8.1",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.8.1",
  "type": "module",
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^9.1.0",
    "@aws-sdk/client-s3": "^3.1156.0",
    "better-sqlite3": "12.11.1",
    "cloudinary": "^2.11.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.5",
    "express": "^5.2.1",
    "morgan": "^1.12.1",
    "multer": "^2.4.0",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^24.10.0",
    "@types/supertest": "^7.2.1",
    "@types/swagger-ui-express": "^4.1.8",
    "supertest": "^7.3.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^5.0.4"
  }
}
