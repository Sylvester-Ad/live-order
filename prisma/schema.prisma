generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum StoreStatus {
  DRAFT
  PUBLISHED   @map("ACTIVE")
  UNPUBLISHED @map("ENDED")
}

enum PaymentStatus {
  PENDING
  PAID
}

enum MobileMoneyProvider {
  MTN_MOBILE_MONEY
  TELECEL_CASH
  AT_MONEY
}

enum StoreMobileMoneySettingsOrigin {
  LEGACY_INHERITED
  STORE_MANAGED
}

enum ImageStorageProvider {
  CLOUDINARY
}

enum ProductImageState {
  ACTIVE
  DELETING
}

enum ProductImageUploadStatus {
  PENDING
  COMPLETED
  DELETED
}

model Creator {
  id             String           @id @default(uuid())
  name           String
  accessCodeHash String           @unique
  sessions       CreatorSession[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  stores                  Store[]
  productCreationRequests ProductCreationRequest[]
  mobileMoneySettings     CreatorMobileMoneySettings?
}

model CreatorSession {
  id        String   @id @default(uuid())
  creatorId String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  creator Creator @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  @@index([creatorId])
  @@index([expiresAt])
}

model Store {
  id            String      @id @default(uuid())
  creatorId     String
  name          String
  slug          String      @unique
  status        StoreStatus @default(DRAFT)
  tiktokLiveUrl String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  creator                 Creator                   @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  products                Product[]
  orders                  Order[]
  productCreationRequests ProductCreationRequest[]
  mobileMoneySettings     StoreMobileMoneySettings?

  @@index([creatorId])
  @@map("Live")
}

model Product {
  id             String   @id @default(uuid())
  storeId        String   @map("liveId")
  name           String
  price          Int
  options        Json?
  stockQuantity  Int      @default(0)
  imageSlotsUsed Int      @default(0)
  isDeleting     Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  store                  Store                   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  orderItems             OrderItem[]
  images                 ProductImage[]
  productCreationRequest ProductCreationRequest?

  @@index([storeId], map: "Product_liveId_idx")
}

model ProductCreationRequest {
  id                 String   @id @default(uuid())
  idempotencyKey     String   @unique
  creatorId          String
  storeId            String   @map("liveId")
  requestFingerprint String
  productId          String?  @unique
  createdAt          DateTime @default(now())

  creator Creator  @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  store   Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([creatorId, storeId], map: "ProductCreationRequest_creatorId_liveId_idx")
}

model ProductImage {
  id              String               @id @default(uuid())
  productId       String
  url             String
  storageId       String
  provider        ImageStorageProvider
  isPrimary       Boolean              @default(true)
  state           ProductImageState    @default(ACTIVE)
  uploadRequestId String?              @unique
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  product       Product                    @relation(fields: [productId], references: [id], onDelete: Cascade)
  uploadRequest ProductImageUploadRequest? @relation(fields: [uploadRequestId], references: [id], onDelete: SetNull)

  @@index([productId])
  @@index([productId, isPrimary])
  @@index([productId, state])
}

model ProductImageUploadRequest {
  id              String                   @id @default(uuid())
  idempotencyKey  String                   @unique
  creatorId       String
  storeId         String                   @map("liveId")
  productId       String
  fileFingerprint String
  status          ProductImageUploadStatus @default(PENDING)
  provider        ImageStorageProvider
  storageId       String
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt

  productImage ProductImage?

  @@index([productId, status])
}

model CreatorMobileMoneySettings {
  id                String              @id @default(uuid())
  creatorId         String              @unique
  provider          MobileMoneyProvider
  mobileMoneyNumber String
  accountName       String
  enabled           Boolean             @default(true)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  creator Creator @relation(fields: [creatorId], references: [id], onDelete: Cascade)
}

model StoreMobileMoneySettings {
  id                String                         @id @default(uuid())
  storeId           String                         @unique
  provider          MobileMoneyProvider
  mobileMoneyNumber String
  accountName       String
  enabled           Boolean                        @default(true)
  origin            StoreMobileMoneySettingsOrigin @default(STORE_MANAGED)
  createdAt         DateTime                       @default(now())
  updatedAt         DateTime                       @updatedAt

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
}

model Order {
  id                     String               @id @default(uuid())
  storeId                String               @map("liveId")
  reference              String?              @unique
  idempotencyKey         String?              @unique
  requestFingerprint     String?
  customerName           String
  customerPhone          String
  deliveryLocation       String
  totalAmount            Int
  paymentStatus          PaymentStatus        @default(PENDING)
  mobileMoneyProvider    MobileMoneyProvider?
  mobileMoneyNumber      String?
  mobileMoneyAccountName String?
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt

  store Store       @relation(fields: [storeId], references: [id], onDelete: Cascade)
  items OrderItem[]

  @@index([storeId], map: "Order_liveId_idx")
  @@index([paymentStatus])
}

model OrderItem {
  id              String  @id @default(uuid())
  orderId         String
  productId       String
  productName     String
  productImageUrl String?
  unitPrice       Int
  quantity        Int
  selectedOptions Json?

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@index([productId])
}
