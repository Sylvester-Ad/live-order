generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum LiveStatus {
  DRAFT
  ACTIVE
  ENDED
}

enum PaymentStatus {
  PENDING
  PAID
}

enum ImageStorageProvider {
  CLOUDINARY
}

enum ProductImageState {
  ACTIVE
  DELETING
}

enum ProductImageUploadStatus {
  PENDING
  COMPLETED
  DELETED
}

model Creator {
  id             String           @id @default(uuid())
  name           String
  accessCodeHash String           @unique
  sessions       CreatorSession[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  lives                   Live[]
  productCreationRequests ProductCreationRequest[]
}

model CreatorSession {
  id        String   @id @default(uuid())
  creatorId String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  creator Creator @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  @@index([creatorId])
  @@index([expiresAt])
}

model Live {
  id            String     @id @default(uuid())
  creatorId     String
  name          String
  slug          String     @unique
  status        LiveStatus @default(DRAFT)
  tiktokLiveUrl String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  creator                 Creator                  @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  products                Product[]
  orders                  Order[]
  productCreationRequests ProductCreationRequest[]

  @@index([creatorId])
}

model Product {
  id             String   @id @default(uuid())
  liveId         String
  name           String
  price          Int
  options        Json?
  stockQuantity  Int      @default(0)
  imageSlotsUsed Int      @default(0)
  isDeleting     Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  live                   Live                    @relation(fields: [liveId], references: [id], onDelete: Cascade)
  orderItems             OrderItem[]
  images                 ProductImage[]
  productCreationRequest ProductCreationRequest?

  @@index([liveId])
}

model ProductCreationRequest {
  id                 String   @id @default(uuid())
  idempotencyKey     String   @unique
  creatorId          String
  liveId             String
  requestFingerprint String
  productId          String?  @unique
  createdAt          DateTime @default(now())

  creator Creator  @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  live    Live     @relation(fields: [liveId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([creatorId, liveId])
}

model ProductImage {
  id              String               @id @default(uuid())
  productId       String
  url             String
  storageId       String
  provider        ImageStorageProvider
  isPrimary       Boolean              @default(true)
  state           ProductImageState    @default(ACTIVE)
  uploadRequestId String?              @unique
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  product       Product                    @relation(fields: [productId], references: [id], onDelete: Cascade)
  uploadRequest ProductImageUploadRequest? @relation(fields: [uploadRequestId], references: [id], onDelete: SetNull)

  @@index([productId])
  @@index([productId, isPrimary])
  @@index([productId, state])
}

model ProductImageUploadRequest {
  id              String                   @id @default(uuid())
  idempotencyKey  String                   @unique
  creatorId       String
  liveId          String
  productId       String
  fileFingerprint String
  status          ProductImageUploadStatus @default(PENDING)
  provider        ImageStorageProvider
  storageId       String
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt

  productImage ProductImage?

  @@index([productId, status])
}

model Order {
  id                 String        @id @default(uuid())
  liveId             String
  reference          String?       @unique
  idempotencyKey     String?       @unique
  requestFingerprint String?
  customerName       String
  customerPhone      String
  deliveryLocation   String
  totalAmount        Int
  paymentStatus      PaymentStatus @default(PENDING)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  live  Live        @relation(fields: [liveId], references: [id], onDelete: Cascade)
  items OrderItem[]

  @@index([liveId])
  @@index([paymentStatus])
}

model OrderItem {
  id              String @id @default(uuid())
  orderId         String
  productId       String
  productName     String
  productImageUrl String?
  unitPrice       Int
  quantity        Int
  selectedOptions Json?

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@index([productId])
}
