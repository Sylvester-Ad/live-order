# SQLite database file. Relative paths are resolved from the repository root.
# Production must set an absolute path on persistent storage, for example:
# LIVEORDER_DATABASE_PATH=/var/lib/liveorder/liveorder.db
LIVEORDER_DATABASE_PATH=./data/dev.db

# Set NODE_ENV=production in the production process to enable secure cookies,
# concise privacy-conscious HTTP logs, and absolute database-path validation.
NODE_ENV=development
PORT=3000

# Product image storage credentials. Keep these server-side in .env.
# Find Cloud name, API Key, and API Secret in Cloudinary Console > Settings > API Keys.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional S3 backup destination for one-off backup commands. AWS credentials
# are resolved by the AWS SDK credential chain (prefer an EC2 instance role).
AWS_REGION=
LIVEORDER_BACKUP_BUCKET=
LIVEORDER_BACKUP_PREFIX=liveorder/backups/sqlite

# Docker Compose settings (optional; these affect only the Caddy service).
# Local HTTP is available at http://localhost:8080 by default.
# For public HTTPS, set SITE_ADDRESS to a hostname whose DNS points to this
# server, then set HTTP_PORT=80 and HTTPS_PORT=443 in the deployment environment.
SITE_ADDRESS=:80
HTTP_PORT=8080
HTTPS_PORT=8443
