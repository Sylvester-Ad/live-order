# SQLite database file. Relative paths are resolved from the repository root.
# Production must set an absolute path on persistent storage, for example:
# LIVEORDER_DATABASE_PATH=/var/lib/liveorder/liveorder.db
LIVEORDER_DATABASE_PATH=./data/dev.db

# Set NODE_ENV=production in the production process to enable secure cookies,
# concise privacy-conscious HTTP logs, and absolute database-path validation.
NODE_ENV=development
PORT=3000

# Product image storage credentials. Keep these server-side in .env.
# Find Cloud name, API Key, and API Secret in Cloudinary Console > Settings > API Keys.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
